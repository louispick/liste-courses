rules_version = '2';

// À coller dans Firebase Console → Firestore → Règles (puis "Publier").
// Seuls les deux comptes ci-dessous peuvent lire/écrire.
service cloud.firestore {
  match /databases/{database}/documents {
    function isCouple() {
      return request.auth != null
        && request.auth.token.email in [
          'louis.pick@gmail.com',
          'mathilde_201@mailo.com'
        ];
    }

    match /{document=**} {
      allow read, write: if false;
    }
    match /items/{id}     { allow read, write: if isCouple(); }
    match /history/{id}   { allow read, write: if isCouple(); }
    match /recipes/{id}   { allow read, write: if isCouple(); }
    match /packing/{id}   { allow read, write: if isCouple(); }
    match /games/{id}     { allow read, write: if isCouple(); }
  }
}
